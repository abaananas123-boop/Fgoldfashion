rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'abaananas123@gmail.com';
    }

    function isValidCategory(cat) {
      return cat is string && cat.size() >= 1 && cat.size() <= 60;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'subtitle',
          'category',
          'price',
          'volume',
          'imageUrl',
          'description',
          'skinTypes',
          'finish',
          'keyActives',
          'fullIngredients',
          'howToUse',
          'variants',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'subtitle',
          'category',
          'subcategory',
          'price',
          'compareAtPrice',
          'volume',
          'stockQuantity',
          'statusNote',
          'imageUrl',
          'videoUrl',
          'mediaGallery',
          'description',
          'skinTypes',
          'finish',
          'keyActives',
          'fullIngredients',
          'howToUse',
          'showSizeGuide',
          'sizeGuideNote',
          'allowCustomStitching',
          'variants',
          'sortOrder',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.subtitle is string && data.subtitle.size() <= 200 &&
        data.category is string && isValidCategory(data.category) &&
        (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 60)) &&
        data.price is number && data.price > 0 && data.price <= 10000000 &&
        (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0 && data.compareAtPrice <= 10000000)) &&
        data.volume is string && data.volume.size() <= 60 &&
        (!('stockQuantity' in data) || (data.stockQuantity is number && data.stockQuantity >= 0 && data.stockQuantity <= 100000)) &&
        (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 60)) &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000 &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2000)) &&
        (!('mediaGallery' in data) || (
          data.mediaGallery is list &&
          data.mediaGallery.size() <= 12 &&
          (data.mediaGallery.size() == 0 || (data.mediaGallery[0] is string && data.mediaGallery[0].size() <= 2000))
        )) &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1500 &&
        data.skinTypes is string && data.skinTypes.size() <= 200 &&
        data.finish is string && data.finish.size() <= 200 &&
        data.keyActives is list && data.keyActives.size() >= 1 && data.keyActives.size() <= 15 &&
        data.keyActives[0] is map &&
        data.fullIngredients is string && data.fullIngredients.size() <= 2000 &&
        data.howToUse is string && data.howToUse.size() <= 1000 &&
        (!('showSizeGuide' in data) || data.showSizeGuide is bool) &&
        (!('sizeGuideNote' in data) || (data.sizeGuideNote is string && data.sizeGuideNote.size() <= 400)) &&
        (!('allowCustomStitching' in data) || data.allowCustomStitching is bool) &&
        data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 20 &&
        data.variants[0] is map &&
        (!('sortOrder' in data) || data.sortOrder is number) &&
        data.updatedAt == request.time;
    }

    function isValidHero3DShowcase(cfg) {
      return cfg is map &&
        cfg.keys().hasAll([
          'mode',
          'frameStyle',
          'aspectShape',
          'depthLevel',
          'autoPlay',
          'items'
        ]) &&
        cfg.keys().hasOnly([
          'enabled',
          'eyebrow',
          'heading',
          'description',
          'helperText',
          'mode',
          'frameStyle',
          'aspectShape',
          'depthLevel',
          'boxTheme',
          'customBgColor',
          'customTextColor',
          'customBorderColor',
          'autoPlay',
          'intervalSeconds',
          'lightingIntensity',
          'shadowDepth',
          'showCaptions',
          'showSubtitle',
          'showCounter',
          'showArrows',
          'showStepper',
          'showHelperText',
          'items',
          'updatedAt'
        ]) &&
        (!('enabled' in cfg) || cfg.enabled is bool) &&
        (!('eyebrow' in cfg) || (cfg.eyebrow is string && cfg.eyebrow.size() <= 80)) &&
        (!('heading' in cfg) || (cfg.heading is string && cfg.heading.size() <= 140)) &&
        (!('description' in cfg) || (cfg.description is string && cfg.description.size() <= 300)) &&
        (!('helperText' in cfg) || (cfg.helperText is string && cfg.helperText.size() <= 160)) &&
        cfg.mode in ['auto-products', 'custom'] &&
        cfg.frameStyle in ['gold', 'frameless', 'obsidian', 'silver'] &&
        cfg.aspectShape in ['portrait', 'square', 'landscape'] &&
        cfg.depthLevel in ['subtle', 'medium', 'bold'] &&
        (!('boxTheme' in cfg) || cfg.boxTheme in ['transparent', 'ivory', 'warm', 'obsidian', 'gold']) &&
        (!('customBgColor' in cfg) || (cfg.customBgColor is string && cfg.customBgColor.size() <= 30)) &&
        (!('customTextColor' in cfg) || (cfg.customTextColor is string && cfg.customTextColor.size() <= 30)) &&
        (!('customBorderColor' in cfg) || (cfg.customBorderColor is string && cfg.customBorderColor.size() <= 30)) &&
        cfg.autoPlay is bool &&
        (!('intervalSeconds' in cfg) || (cfg.intervalSeconds is number && cfg.intervalSeconds >= 2 && cfg.intervalSeconds <= 15)) &&
        (!('lightingIntensity' in cfg) || (cfg.lightingIntensity is number && cfg.lightingIntensity >= 40 && cfg.lightingIntensity <= 200)) &&
        (!('shadowDepth' in cfg) || (cfg.shadowDepth is number && cfg.shadowDepth >= 0 && cfg.shadowDepth <= 200)) &&
        (!('showCaptions' in cfg) || cfg.showCaptions is bool) &&
        (!('showSubtitle' in cfg) || cfg.showSubtitle is bool) &&
        (!('showCounter' in cfg) || cfg.showCounter is bool) &&
        (!('showArrows' in cfg) || cfg.showArrows is bool) &&
        (!('showStepper' in cfg) || cfg.showStepper is bool) &&
        (!('showHelperText' in cfg) || cfg.showHelperText is bool) &&
        cfg.items is list &&
        cfg.items.size() <= 16 &&
        (cfg.items.size() == 0 || cfg.items[0] is map) &&
        (!('updatedAt' in cfg) || cfg.updatedAt == request.time);
    }

    function isValidHeroHighlightSlider(cfg) {
      return cfg is map &&
        cfg.keys().hasAll([
          'enabled',
          'eyebrow',
          'heading',
          'layout',
          'aspectShape',
          'boxTheme',
          'autoPlay',
          'intervalSeconds',
          'showCaptions',
          'showArrows',
          'items',
          'updatedAt'
        ]) &&
        cfg.keys().hasOnly([
          'enabled',
          'eyebrow',
          'heading',
          'description',
          'layout',
          'aspectShape',
          'boxTheme',
          'customBgColor',
          'customTextColor',
          'customBorderColor',
          'autoPlay',
          'intervalSeconds',
          'showCaptions',
          'showArrows',
          'items',
          'updatedAt'
        ]) &&
        cfg.enabled is bool &&
        cfg.eyebrow is string && cfg.eyebrow.size() <= 80 &&
        cfg.heading is string && cfg.heading.size() <= 140 &&
        (!('description' in cfg) || (cfg.description is string && cfg.description.size() <= 300)) &&
        cfg.layout in ['carousel', 'spotlight', 'compact'] &&
        cfg.aspectShape in ['portrait', 'square', 'landscape', 'wide'] &&
        cfg.boxTheme in ['ivory', 'warm', 'obsidian', 'gold'] &&
        (!('customBgColor' in cfg) || (cfg.customBgColor is string && cfg.customBgColor.size() <= 30)) &&
        (!('customTextColor' in cfg) || (cfg.customTextColor is string && cfg.customTextColor.size() <= 30)) &&
        (!('customBorderColor' in cfg) || (cfg.customBorderColor is string && cfg.customBorderColor.size() <= 30)) &&
        cfg.autoPlay is bool &&
        cfg.intervalSeconds is number && cfg.intervalSeconds >= 2 && cfg.intervalSeconds <= 15 &&
        cfg.showCaptions is bool &&
        cfg.showArrows is bool &&
        cfg.items is list &&
        cfg.items.size() <= 24 &&
        (cfg.items.size() == 0 || cfg.items[0] is map) &&
        cfg.updatedAt == request.time;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'storeName',
          'footerTagline',
          'accentColor',
          'navLabels',
          'hero',
          'catalogSection',
          'philosophy',
          'checkout',
          'socialLinks',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'storeName',
          'footerTagline',
          'accentColor',
          'headerBackgroundImage',
          'headerTextTheme',
          'navLabels',
          'categories',
          'subcategories',
          'hero',
          'hero3dShowcase',
          'catalogSection',
          'featuresSection',
          'philosophy',
          'checkout',
          'socialLinks',
          'seo',
          'teamMembers',
          'customBoxes',
          'customLinks',
          'homeSliders',
          'customSections',
          'homeTheme',
          'visibility',
          'homeLayout',
          'updatedAt'
        ]) &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100 &&
        data.footerTagline is string && data.footerTagline.size() <= 300 &&
        data.accentColor is string && data.accentColor.size() == 7 && data.accentColor[0:1] == '#' &&
        (!('headerBackgroundImage' in data) || (data.headerBackgroundImage is string && data.headerBackgroundImage.size() <= 250000)) &&
        (!('headerTextTheme' in data) || data.headerTextTheme in ['dark', 'light']) &&
        data.navLabels is map &&
        (!('categories' in data) || (
          data.categories is list &&
          data.categories.size() >= 1 &&
          data.categories.size() <= 40 &&
          data.categories[0] is string &&
          data.categories[0].size() >= 1 &&
          data.categories[0].size() <= 60
        )) &&
        (!('subcategories' in data) || data.subcategories is map) &&
        data.hero is map &&
        (!('hero3dShowcase' in data) || isValidHero3DShowcase(data.hero3dShowcase)) &&
        data.catalogSection is map &&
        (!('featuresSection' in data) || data.featuresSection is map) &&
        data.philosophy is map &&
        data.checkout is map &&
        data.socialLinks is map &&
        ('whatsappNumber' in data.socialLinks) &&
        data.socialLinks.whatsappNumber is string && data.socialLinks.whatsappNumber.size() <= 30 &&
        ('whatsappMessage' in data.socialLinks) &&
        data.socialLinks.whatsappMessage is string && data.socialLinks.whatsappMessage.size() <= 300 &&
        ('showOnProductPage' in data.socialLinks) &&
        data.socialLinks.showOnProductPage is bool &&
        ('accounts' in data.socialLinks) &&
        data.socialLinks.accounts is list && data.socialLinks.accounts.size() <= 20 &&
        (data.socialLinks.accounts.size() == 0 || data.socialLinks.accounts[0] is map) &&
        (!('seo' in data) || data.seo is map) &&
        (!('teamMembers' in data) || (
          data.teamMembers is list &&
          data.teamMembers.size() <= 30 &&
          (data.teamMembers.size() == 0 || data.teamMembers[0] is map)
        )) &&
        (!('customBoxes' in data) || (
          data.customBoxes is list &&
          data.customBoxes.size() <= 24 &&
          (data.customBoxes.size() == 0 || data.customBoxes[0] is map)
        )) &&
        (!('customLinks' in data) || (
          data.customLinks is list &&
          data.customLinks.size() <= 30 &&
          (data.customLinks.size() == 0 || data.customLinks[0] is map)
        )) &&
        (!('homeSliders' in data) || (
          data.homeSliders is list &&
          data.homeSliders.size() <= 12 &&
          (data.homeSliders.size() == 0 || data.homeSliders[0] is map)
        )) &&
        (!('customSections' in data) || (
          data.customSections is list &&
          data.customSections.size() <= 15 &&
          (data.customSections.size() == 0 || data.customSections[0] is map)
        )) &&
        (!('homeTheme' in data) || data.homeTheme is map) &&
        (!('visibility' in data) || data.visibility is map) &&
        (!('homeLayout' in data) || data.homeLayout is map) &&
        data.updatedAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber',
          'createdAt',
          'createdTimestamp',
          'status',
          'items',
          'subtotal',
          'discount',
          'shippingCost',
          'total',
          'paymentMethod',
          'shipping'
        ]) &&
        data.keys().hasOnly([
          'orderNumber',
          'createdAt',
          'createdTimestamp',
          'status',
          'items',
          'subtotal',
          'discount',
          'shippingCost',
          'total',
          'paymentMethod',
          'shipping',
          'orderNote',
          'customerUid'
        ]) &&
        data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() >= 3 && data.createdAt.size() <= 40 &&
        data.createdTimestamp is timestamp &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 80 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discount is number && data.discount >= 0 &&
        data.shippingCost is number && data.shippingCost >= 0 &&
        data.total is number && data.total >= 0 &&
        data.paymentMethod in ['wallet', 'card', 'cod'] &&
        (!('orderNote' in data) || (data.orderNote is string && data.orderNote.size() <= 300)) &&
        (!('customerUid' in data) || isValidId(data.customerUid)) &&
        data.shipping is map &&
        data.shipping.keys().hasAll([
          'fullName',
          'email',
          'phone',
          'address',
          'city',
          'postalCode'
        ]) &&
        data.shipping.keys().hasOnly([
          'fullName',
          'email',
          'phone',
          'address',
          'city',
          'postalCode'
        ]) &&
        data.shipping.fullName is string && data.shipping.fullName.size() >= 1 && data.shipping.fullName.size() <= 120 &&
        data.shipping.email is string && data.shipping.email.size() >= 3 && data.shipping.email.size() <= 160 &&
        data.shipping.phone is string && data.shipping.phone.size() >= 6 && data.shipping.phone.size() <= 32 &&
        data.shipping.address is string && data.shipping.address.size() >= 3 && data.shipping.address.size() <= 300 &&
        data.shipping.city is string && data.shipping.city.size() >= 2 && data.shipping.city.size() <= 80 &&
        data.shipping.postalCode is string && data.shipping.postalCode.size() >= 2 && data.shipping.postalCode.size() <= 20;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
          'orderNumber',
          'status',
          'destinationCity',
          'itemCount',
          'orderDateLabel',
          'updatedAtLabel',
          'events',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber',
          'status',
          'courierName',
          'trackingNumber',
          'trackingUrl',
          'estimatedDelivery',
          'destinationCity',
          'itemCount',
          'orderDateLabel',
          'updatedAtLabel',
          'events',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.orderNumber) &&
        data.orderNumber.size() >= 3 &&
        data.orderNumber.size() <= 32 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 80 &&
        (!('courierName' in data) || (data.courierName is string && data.courierName.size() >= 1 && data.courierName.size() <= 80)) &&
        (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() >= 1 && data.trackingNumber.size() <= 80)) &&
        (!('trackingUrl' in data) || (data.trackingUrl is string && data.trackingUrl.size() >= 8 && data.trackingUrl.size() <= 300 && data.trackingUrl.matches('^https?://.*'))) &&
        (!('estimatedDelivery' in data) || (data.estimatedDelivery is string && data.estimatedDelivery.size() >= 1 && data.estimatedDelivery.size() <= 80)) &&
        data.destinationCity is string && data.destinationCity.size() >= 2 && data.destinationCity.size() <= 80 &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.orderDateLabel is string && data.orderDateLabel.size() >= 3 && data.orderDateLabel.size() <= 40 &&
        data.updatedAtLabel is string && data.updatedAtLabel.size() >= 3 && data.updatedAtLabel.size() <= 60 &&
        data.events is list && data.events.size() >= 1 && data.events.size() <= 25 &&
        data.events[0] is map &&
        data.events[0].keys().hasAll(['id', 'timestamp', 'status']) &&
        data.events[0].keys().hasOnly(['id', 'timestamp', 'status', 'location', 'note']) &&
        data.events[0].id is string && data.events[0].id.size() >= 1 && data.events[0].id.size() <= 64 &&
        data.events[0].timestamp is string && data.events[0].timestamp.size() >= 3 && data.events[0].timestamp.size() <= 60 &&
        data.events[0].status is string && data.events[0].status.size() >= 1 && data.events[0].status.size() <= 80 &&
        (!('location' in data.events[0]) || (data.events[0].location is string && data.events[0].location.size() <= 80)) &&
        (!('note' in data.events[0]) || (data.events[0].note is string && data.events[0].note.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidProductReview(data) {
      return data.keys().hasAll([
          'id',
          'productId',
          'productName',
          'authorName',
          'rating',
          'comment',
          'status',
          'createdAtLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'productId',
          'productName',
          'authorName',
          'rating',
          'comment',
          'fitNote',
          'photoUrl',
          'status',
          'createdAtLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 600 &&
        (!('fitNote' in data) || (data.fitNote is string && data.fitNote.size() <= 80)) &&
        (!('photoUrl' in data) || (
          data.photoUrl is string &&
          data.photoUrl.size() >= 8 &&
          data.photoUrl.size() <= 250000 &&
          (data.photoUrl.matches('^https?://.*') || data.photoUrl[0:11] == 'data:image/')
        )) &&
        data.status in ['pending', 'approved'] &&
        data.createdAtLabel is string && data.createdAtLabel.size() >= 3 && data.createdAtLabel.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidRestockRequest(data) {
      return data.keys().hasAll([
          'id',
          'productId',
          'productName',
          'variantName',
          'contact',
          'createdAtLabel',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'productId',
          'productName',
          'variantName',
          'contact',
          'createdAtLabel',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.variantName is string && data.variantName.size() >= 1 && data.variantName.size() <= 120 &&
        data.contact is string && data.contact.size() >= 5 && data.contact.size() <= 120 &&
        data.createdAtLabel is string && data.createdAtLabel.size() >= 3 && data.createdAtLabel.size() <= 40 &&
        data.createdAt == request.time;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'source', 'subscribedAt']) &&
        data.keys().hasOnly(['email', 'source', 'subscribedAt']) &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 160 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.source is string &&
        data.source.size() >= 1 &&
        data.source.size() <= 40 &&
        data.source == 'footer' &&
        data.subscribedAt == request.time;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'url',
          'mediaKind',
          'categoryTag',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'title',
          'url',
          'mediaKind',
          'categoryTag',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 350000 &&
        data.mediaKind in ['image', 'video'] &&
        data.categoryTag is string && data.categoryTag.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPublicMedia(data) {
      return data.keys().hasAll([
          'id',
          'dataUrl',
          'mediaKind',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'dataUrl',
          'mediaKind',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.dataUrl is string &&
        data.dataUrl.size() >= 15 &&
        data.dataUrl.size() <= 750000 &&
        (data.dataUrl[0:11] == 'data:image/' || data.dataUrl[0:11] == 'data:video/') &&
        data.mediaKind in ['image', 'video'] &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidCustomerProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'phone',
          'defaultAddress',
          'defaultCity',
          'defaultPostalCode',
          'photoUrl',
          'followedStore',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('defaultAddress' in data) || (data.defaultAddress is string && data.defaultAddress.size() <= 300)) &&
        (!('defaultCity' in data) || (data.defaultCity is string && data.defaultCity.size() <= 80)) &&
        (!('defaultPostalCode' in data) || (data.defaultPostalCode is string && data.defaultPostalCode.size() <= 20)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000)) &&
        (!('followedStore' in data) || data.followedStore is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Connection ping document
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Catalog Products: public read, Admin full write, checkout strictly limited to atomic stockQuantity decrement
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isValidId(productId) && (
        (isAdmin() && isValidProduct(incoming()) && incoming().id == existing().id) ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'updatedAt']) &&
          ('stockQuantity' in existing()) &&
          existing().stockQuantity is number &&
          incoming().stockQuantity is number &&
          incoming().stockQuantity >= 0 &&
          incoming().stockQuantity < existing().stockQuantity &&
          incoming().updatedAt == request.time
        )
      );
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Storefront Settings & Social Links: public read, strictly Admin-only write
    match /settings/siteConfig {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() && isValidSiteConfig(incoming());
      allow update: if isAdmin() && isValidSiteConfig(incoming());
      allow delete: if false;
    }

    // Hero 3D Showcase Settings: public read, strictly Admin-only write
    match /settings/hero3dShowcase {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() && isValidHero3DShowcase(incoming());
      allow update: if isAdmin() && isValidHero3DShowcase(incoming());
      allow delete: if false;
    }

    // Hero Highlight Slider Settings: public read, strictly Admin-only write
    match /settings/heroHighlightSlider {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() && isValidHeroHighlightSlider(incoming());
      allow update: if isAdmin() && isValidHeroHighlightSlider(incoming());
      allow delete: if false;
    }

    // Customer Orders: create allowed with strict payload & owner UID binding; reads strictly isolated to owning signed-in customer or Admin
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && ('customerUid' in existing()) && existing().customerUid == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        resource.data.customerUid == request.auth.uid
      );
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().createdTimestamp == request.time &&
        (!('customerUid' in incoming()) || (isSignedIn() && (isAdmin() || incoming().customerUid == request.auth.uid))) &&
        (isAdmin() || incoming().status == 'Confirmed — Preparing Shipment');
      allow update: if isAdmin() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().createdTimestamp == existing().createdTimestamp &&
        incoming().orderNumber == existing().orderNumber;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Customer Account Profiles: strictly private per signed-in user UID (and Admin support)
    match /customerProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidCustomerProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidCustomerProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Zero-PII Public Order Tracking Projection: public get strictly by exact Order ID; admin-only list/update/delete
    match /orderTracking/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId) &&
        isValidOrderTracking(incoming()) &&
        incoming().orderNumber == orderId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || (
          incoming().status == 'Confirmed — Preparing Shipment' &&
          incoming().events.size() == 1 &&
          !('courierName' in incoming()) &&
          !('trackingNumber' in incoming()) &&
          !('trackingUrl' in incoming()) &&
          !('estimatedDelivery' in incoming())
        ));
      allow update: if isAdmin() &&
        isValidId(orderId) &&
        isValidOrderTracking(incoming()) &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Newsletter Subscribers: create allowed with strict email and server-timestamp validation; PII read/list/delete strictly Admin-only
    match /subscribers/{subscriberId} {
      allow get: if isAdmin() && isValidId(subscriberId);
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // Manager Media Library: reusable product photos/videos strictly Admin-only
    match /mediaLibrary/{mediaId} {
      allow get: if isAdmin() && isValidId(mediaId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(mediaId) &&
        isValidMediaAsset(incoming()) &&
        incoming().id == mediaId &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(mediaId) &&
        isValidMediaAsset(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Cloud-Persisted Store Media: public get by ID (served to storefront & social links), strictly Admin-only write/list/delete
    match /publicMedia/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(mediaId) &&
        isValidPublicMedia(incoming()) &&
        incoming().id == mediaId &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(mediaId) &&
        isValidPublicMedia(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Customer Product Reviews: public create (pending only), approved-only public list/get, admin full moderation
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (isAdmin() || existing().status == 'approved');
      allow list: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidId(reviewId) &&
        isValidProductReview(incoming()) &&
        incoming().id == reviewId &&
        incoming().createdAt == request.time &&
        (isAdmin() || incoming().status == 'pending');
      allow update: if isAdmin() &&
        isValidId(reviewId) &&
        isValidProductReview(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    // Restock Notification Requests: public create-only, strictly Admin-only read/list/delete
    match /restockRequests/{requestId} {
      allow get: if isAdmin() && isValidId(requestId);
      allow list: if isAdmin();
      allow create: if isValidId(requestId) &&
        isValidRestockRequest(incoming()) &&
        incoming().id == requestId;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(requestId);
    }
  }
}
